<?xml version='1.0' encoding='utf-8'?>
<icferst_options>
  <simulation_name>
    <string_value lines="1">z_toy_phiC_conservation</string_value>
  </simulation_name>
  <porous_media_simulator/>
  <geometry>
    <dimension>
      <integer_value rank="0">3</integer_value>
    </dimension>
    <mesh name="CoordinateMesh">
      <from_file file_name="two_region_box">
        <format name="gmsh"/>
        <stat>
          <include_in_stat/>
        </stat>
      </from_file>
    </mesh>
    <simulation_quality>
      <string_value>balanced</string_value>
    </simulation_quality>
    <Advance_options>
      <Conservative_formulation_settings name="Tracer">
        <conservative_advection>
          <real_value rank="0">1.0</real_value>
        </conservative_advection>
      </Conservative_formulation_settings>
    </Advance_options>
  </geometry>
  <solver_options>
    <Linear_solver>
      <iterative_method name="gmres">
        <restart>
          <integer_value rank="0">30</integer_value>
        </restart>
      </iterative_method>
      <preconditioner name="hypre">
        <hypre_type name="boomeramg"/>
      </preconditioner>
      <relative_error>
        <real_value rank="0">1.0e-13</real_value>
      </relative_error>
      <max_iterations>
        <integer_value rank="0">1000</integer_value>
      </max_iterations>
      <ignore_all_solver_failures/>
      <diagnostics>
        <monitors/>
      </diagnostics>
      <Custom_solver_configuration/>
    </Linear_solver>
    <Non_Linear_Solver>
      <integer_value rank="0">20</integer_value>
      <Fixed_Point_Iteration>
        <real_value rank="0">0.05</real_value>
        <Infinite_norm_tol>
          <real_value rank="0">0.001</real_value>
          <adaptive_non_linear_iterations>
            <integer_value rank="0">1</integer_value>
          </adaptive_non_linear_iterations>
        </Infinite_norm_tol>
        <Backtracking_factor>
          <real_value rank="0">-10</real_value>
        </Backtracking_factor>
      </Fixed_Point_Iteration>
    </Non_Linear_Solver>
  </solver_options>
  <io>
    <dump_format>
      <string_value>vtk</string_value>
    </dump_format>
    <dump_units_SI/>
    <dump_period_in_timesteps>
      <constant>
        <integer_value rank="0">1</integer_value>
      </constant>
    </dump_period_in_timesteps>
    <Show_Convergence_Detailed/>
  </io>
  <timestepping>
    <current_time>
      <real_value rank="0">0</real_value>
    </current_time>
    <timestep>
      <real_value rank="0">100</real_value>
    </timestep>
    <finish_time>
      <real_value rank="0">800</real_value>
    </finish_time>
  </timestepping>
  <physical_parameters>
    <gravity>
      <magnitude>
        <real_value rank="0">9.81</real_value>
      </magnitude>
      <vector_field name="GravityDirection" rank="1">
        <prescribed>
          <mesh name="CoordinateMesh"/>
          <value name="WholeMesh">
            <constant>
              <real_value rank="1" dim1="dim" shape="3">0 0 -1</real_value>
            </constant>
          </value>
          <stat>
            <include_in_stat/>
          </stat>
          <detectors>
            <exclude_from_detectors/>
          </detectors>
        </prescribed>
      </vector_field>
    </gravity>
  </physical_parameters>
  <material_phase name="aquifer">
    <phase_properties>
      <Density>
        <incompressible>
          <real_value rank="0">1000</real_value>
        </incompressible>
      </Density>
      <Viscosity>
        <tensor_field name="Viscosity" rank="2">
          <prescribed>
            <mesh name="PressureMesh"/>
            <value name="WholeMesh">
              <isotropic>
                <constant>
                  <real_value rank="0">0.001</real_value>
                </constant>
              </isotropic>
            </value>
          </prescribed>
        </tensor_field>
        <viscosity_scheme>
          <tensor_form/>
          <nonlinear_scheme/>
        </viscosity_scheme>
      </Viscosity>
    </phase_properties>
    <scalar_field rank="0" name="Pressure">
      <prognostic>
        <mesh name="PressureMesh"/>
        <initial_condition name="WholeMesh">
          <python>
            <string_value type="code" language="python" lines="20">def val(X,t):
 p = 1e5 - 1000*9.81*X[2]
 return p</string_value>
          </python>
        </initial_condition>
        <boundary_conditions name="hydrostatic">
          <surface_ids>
            <integer_value rank="1" shape="2">3 5</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <hydrostatic_boundaries/>
            <python>
              <string_value type="code" language="python" lines="20">def val(X,t):
 p = 1e5 - 1000*9.81*X[2]
 return p</string_value>
            </python>
          </type>
        </boundary_conditions>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <adaptivity_options>
          <relative_measure>
            <scalar_field rank="0" name="InterpolationErrorBound">
              <prescribed>
                <value name="WholeMesh">
                  <constant>
                    <real_value rank="0">0.08</real_value>
                  </constant>
                </value>
                <stat/>
                <detectors>
                  <exclude_from_detectors/>
                </detectors>
              </prescribed>
            </scalar_field>
          </relative_measure>
        </adaptivity_options>
        <galerkin_projection>
          <continuous>
            <solver/>
          </continuous>
        </galerkin_projection>
        <output/>
      </prognostic>
    </scalar_field>
    <vector_field rank="1" name="Velocity">
      <prognostic>
        <mesh name="VelocityMesh"/>
        <initial_condition name="WholeMesh">
          <constant>
            <real_value rank="1" dim1="dim" shape="3">0 0 0</real_value>
          </constant>
        </initial_condition>
        <boundary_conditions name="closed_walls">
          <surface_ids>
            <integer_value rank="1" shape="4">1 2 4 6</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <align_bc_with_cartesian>
              <x_component>
                <constant>
                  <real_value rank="0">0</real_value>
                </constant>
              </x_component>
              <y_component>
                <constant>
                  <real_value rank="0">0</real_value>
                </constant>
              </y_component>
              <z_component>
                <constant>
                  <real_value rank="0">0</real_value>
                </constant>
              </z_component>
            </align_bc_with_cartesian>
          </type>
        </boundary_conditions>
        <detectors>
          <exclude_from_detectors/>
        </detectors>
        <galerkin_projection>
          <discontinuous/>
        </galerkin_projection>
        <output>
          <exclude_from_vtu/>
        </output>
      </prognostic>
    </vector_field>
    <scalar_field rank="0" name="PhaseVolumeFraction">
      <prognostic>
        <mesh name="PressureMesh"/>
        <initial_condition name="WholeMesh">
          <constant>
            <real_value rank="0">1</real_value>
          </constant>
        </initial_condition>
        <detectors>
          <exclude_from_detectors/>
        </detectors>
        <galerkin_projection>
          <continuous>
            <solver/>
          </continuous>
        </galerkin_projection>
      </prognostic>
    </scalar_field>
    <scalar_field rank="0" name="Concentration">
      <prognostic>
        <mesh name="PressureMesh"/>
        <Do_not_impose_min_max/>
        <initial_condition name="WholeMesh">
          <python>
            <string_value type="code" language="python" lines="20">def val(X,t):
 from math import exp
 r2 = X[0]**2 + X[1]**2 + (X[2]+50.0)**2
 return 520.0*exp(-r2/(2.0*15.0**2))</string_value>
          </python>
        </initial_condition>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <adaptivity_options>
          <relative_measure>
            <scalar_field rank="0" name="InterpolationErrorBound">
              <prescribed>
                <value name="WholeMesh">
                  <constant>
                    <real_value rank="0">0.06</real_value>
                  </constant>
                </value>
                <stat/>
                <detectors>
                  <exclude_from_detectors/>
                </detectors>
              </prescribed>
            </scalar_field>
          </relative_measure>
        </adaptivity_options>
        <galerkin_projection>
          <continuous>
            <solver/>
          </continuous>
        </galerkin_projection>
      </prognostic>
    </scalar_field>
  </material_phase>
  <mesh_adaptivity>
    <hr_adaptivity>
      <period_in_timesteps>
        <constant>
          <integer_value rank="0">1</integer_value>
        </constant>
      </period_in_timesteps>
      <maximum_number_of_nodes>
        <integer_value rank="0">3000</integer_value>
      </maximum_number_of_nodes>
      <enable_gradation>
        <gradation_parameter>
          <real_value rank="0">3</real_value>
        </gradation_parameter>
      </enable_gradation>
      <tensor_field name="MinimumEdgeLengths">
        <anisotropic_symmetric>
          <constant>
            <real_value symmetric="true" rank="2" dim1="dim" dim2="dim" shape="3 3">2 0 0 0 2 0 0 0 2</real_value>
          </constant>
        </anisotropic_symmetric>
      </tensor_field>
      <tensor_field name="MaximumEdgeLengths">
        <anisotropic_symmetric>
          <constant>
            <real_value symmetric="true" rank="2" dim1="dim" dim2="dim" shape="3 3">30 0 0 0 30 0 0 0 30</real_value>
          </constant>
        </anisotropic_symmetric>
      </tensor_field>
      <aspect_ratio_bound>
        <real_value rank="0">3</real_value>
      </aspect_ratio_bound>
    </hr_adaptivity>
  </mesh_adaptivity>
  <porous_media>
    <scalar_field name="Porosity">
      <prescribed>
        <mesh name="P0DG"/>
        <value name="top_high_phi">
          <region_ids>
            <integer_value rank="1" shape="1">1</integer_value>
          </region_ids>
          <constant>
            <real_value rank="0">0.5</real_value>
          </constant>
        </value>
        <value name="bottom_low_phi">
          <region_ids>
            <integer_value rank="1" shape="1">2</integer_value>
          </region_ids>
          <constant>
            <real_value rank="0">0.06</real_value>
          </constant>
        </value>
        <stat/>
        <detectors>
          <exclude_from_detectors/>
        </detectors>
        <output/>
      </prescribed>
    </scalar_field>
    <vector_field name="Permeability">
      <prescribed>
        <mesh name="P0DG"/>
        <value name="WholeMesh">
          <constant>
            <real_value rank="1" dim1="dim" shape="3">1e-20 1e-20 1e-20</real_value>
          </constant>
        </value>
        <stat>
          <include_in_stat/>
        </stat>
        <detectors>
          <exclude_from_detectors/>
        </detectors>
        <output/>
      </prescribed>
    </vector_field>
  </porous_media>
</icferst_options>
