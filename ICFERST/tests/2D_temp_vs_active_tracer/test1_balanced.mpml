<?xml version='1.0' encoding='utf-8'?>
<icferst_options>
  <simulation_name>
    <string_value lines="1">2D_Temperature_Concentration_comparison_adv_diff</string_value>
  </simulation_name>
  <porous_media_simulator/>
  <geometry>
    <dimension>
      <integer_value rank="0">2</integer_value>
    </dimension>
    <mesh name="CoordinateMesh">
      <from_file file_name="box">
        <format name="gmsh"/>
        <stat>
          <include_in_stat/>
        </stat>
      </from_file>
    </mesh>
    <simulation_quality>
      <string_value>balanced</string_value>
    </simulation_quality>
  </geometry>
  <solver_options>
    <Non_Linear_Solver>
      <integer_value rank="0">15</integer_value>
      <Fixed_Point_Iteration>
        <real_value rank="0">5e-2</real_value>
        <Infinite_norm_tol>
          <real_value rank="0">0.01</real_value>
          <adaptive_non_linear_iterations>
            <integer_value rank="0">2</integer_value>
          </adaptive_non_linear_iterations>
        </Infinite_norm_tol>
        <Backtracking_factor>
          <real_value rank="0">1</real_value>
        </Backtracking_factor>
        <Vanishing_relaxation>
          <real_value rank="0">0</real_value>
          <Vanishing_for_transport>
            <real_value rank="0">-1e2</real_value>
          </Vanishing_for_transport>
        </Vanishing_relaxation>
        <adaptive_timestep_nonlinear>
          <integer_value rank="0">5</integer_value>
          <PID_controller>
            <Aim_num_FPI>
              <integer_value rank="0">5</integer_value>
            </Aim_num_FPI>
          </PID_controller>
          <max_timestep>
            <python>
              <string_value type="code" language="python" lines="20">def val(t):
 val = 300
 return val</string_value>
            </python>
          </max_timestep>
          <min_timestep>
            <python>
              <string_value type="code" language="python" lines="20">def val(t):
 val = 1
 return val</string_value>
            </python>
          </min_timestep>
        </adaptive_timestep_nonlinear>
      </Fixed_Point_Iteration>
    </Non_Linear_Solver>
  </solver_options>
  <io>
    <dump_format>
      <string_value>vtk</string_value>
    </dump_format>
    <dump_units_SI/>
    <dump_period>
      <constant>
        <real_value rank="0">180</real_value>
      </constant>
    </dump_period>
    <Show_Convergence_Detailed/>
  </io>
  <timestepping>
    <current_time>
      <real_value rank="0">0.0</real_value>
    </current_time>
    <timestep>
      <real_value rank="0">1</real_value>
    </timestep>
    <finish_time>
      <real_value rank="0">3600</real_value>
    </finish_time>
  </timestepping>
  <physical_parameters>
    <gravity>
      <magnitude>
        <real_value rank="0">9.81</real_value>
      </magnitude>
      <vector_field name="GravityDirection" rank="1">
        <prescribed>
          <mesh name="CoordinateMesh"/>
          <value name="WholeMesh">
            <constant>
              <real_value rank="1" dim1="dim" shape="2">0 -1</real_value>
            </constant>
          </value>
          <stat>
            <include_in_stat/>
          </stat>
          <detectors>
            <exclude_from_detectors/>
          </detectors>
        </prescribed>
      </vector_field>
    </gravity>
  </physical_parameters>
  <material_phase name="phase1">
    <phase_properties>
      <Density>
        <compressible>
          <Linear_eos>
            <reference_density>
              <real_value rank="0">1000</real_value>
            </reference_density>
          </Linear_eos>
        </compressible>
      </Density>
      <Viscosity>
        <tensor_field name="Viscosity" rank="2">
          <prescribed>
            <mesh name="PressureMesh"/>
            <value name="WholeMesh">
              <isotropic>
                <constant>
                  <real_value rank="0">1e-3</real_value>
                </constant>
              </isotropic>
            </value>
          </prescribed>
        </tensor_field>
        <viscosity_scheme>
          <tensor_form/>
          <nonlinear_scheme/>
        </viscosity_scheme>
      </Viscosity>
      <tensor_field name="Thermal_Conductivity" rank="2">
        <prescribed>
          <value name="WholeMesh">
            <isotropic>
              <constant>
                <real_value rank="0">0.066</real_value>
              </constant>
            </isotropic>
          </value>
          <output/>
        </prescribed>
      </tensor_field>
      <scalar_field name="HeatCapacity" rank="0">
        <prescribed>
          <value name="WholeMesh">
            <constant>
              <real_value rank="0">1</real_value>
            </constant>
          </value>
          <stat/>
          <detectors>
            <exclude_from_detectors/>
          </detectors>
        </prescribed>
      </scalar_field>
    </phase_properties>
    <scalar_field rank="0" name="Pressure">
      <prognostic>
        <mesh name="PressureMesh"/>
        <initial_condition name="WholeMesh">
          <constant>
            <real_value rank="0">0.0</real_value>
          </constant>
        </initial_condition>
        <boundary_conditions name="right">
          <surface_ids>
            <integer_value rank="1" shape="1">8</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <hydrostatic_boundaries/>
            <constant>
              <real_value rank="0">0.0</real_value>
            </constant>
          </type>
        </boundary_conditions>
        <detectors>
          <exclude_from_detectors/>
        </detectors>
        <consistent_interpolation/>
        <output/>
      </prognostic>
    </scalar_field>
    <vector_field rank="1" name="Velocity">
      <prognostic>
        <mesh name="VelocityMesh"/>
        <initial_condition name="WholeMesh">
          <constant>
            <real_value rank="1" dim1="dim" shape="2">0 0</real_value>
          </constant>
        </initial_condition>
        <boundary_conditions name="left">
          <surface_ids>
            <integer_value rank="1" shape="1">7</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <align_bc_with_cartesian>
              <x_component>
                <constant>
                  <real_value rank="0">6.6e-5</real_value>
                </constant>
              </x_component>
              <y_component>
                <constant>
                  <real_value rank="0">0</real_value>
                </constant>
              </y_component>
            </align_bc_with_cartesian>
          </type>
        </boundary_conditions>
        <boundary_conditions name="top_bottom">
          <surface_ids>
            <integer_value rank="1" shape="2">9 10</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <align_bc_with_cartesian>
              <x_component>
                <constant>
                  <real_value rank="0">0</real_value>
                </constant>
              </x_component>
              <y_component>
                <constant>
                  <real_value rank="0">0</real_value>
                </constant>
              </y_component>
            </align_bc_with_cartesian>
          </type>
        </boundary_conditions>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <consistent_interpolation/>
        <output/>
      </prognostic>
    </vector_field>
    <scalar_field rank="0" name="Density">
      <prognostic>
        <mesh name="PressureMesh"/>
        <Impose_min_max>
          <automatic_min_limit/>
          <automatic_max_limit/>
        </Impose_min_max>
        <initial_condition name="WholeMesh">
          <constant>
            <real_value rank="0">1000</real_value>
          </constant>
        </initial_condition>
        <boundary_conditions name="all">
          <surface_ids>
            <integer_value rank="1" shape="4">7 8 9 10</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <constant>
              <real_value rank="0">1000</real_value>
            </constant>
          </type>
        </boundary_conditions>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <consistent_interpolation/>
        <output/>
      </prognostic>
    </scalar_field>
    <scalar_field rank="0" name="PhaseVolumeFraction">
      <prognostic>
        <mesh name="PressureMesh"/>
        <initial_condition name="WholeMesh">
          <constant>
            <real_value rank="0">1</real_value>
          </constant>
        </initial_condition>
        <boundary_conditions name="rest">
          <surface_ids>
            <integer_value rank="1" shape="2">9 10</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <constant>
              <real_value rank="0">0</real_value>
            </constant>
          </type>
        </boundary_conditions>
        <boundary_conditions name="inout">
          <surface_ids>
            <integer_value rank="1" shape="2">7 8</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <constant>
              <real_value rank="0">1</real_value>
            </constant>
          </type>
        </boundary_conditions>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <consistent_interpolation/>
      </prognostic>
    </scalar_field>
    <scalar_field rank="0" name="Concentration">
      <prognostic>
        <mesh name="PressureMesh"/>
        <Do_not_impose_min_max/>
        <tensor_field name="Diffusivity" rank="2">
          <prescribed>
            <value name="WholeMesh">
              <isotropic>
                <constant>
                  <real_value rank="0">0.66e-4</real_value>
                  <comment>concentration diffusivity = kappa/rhof

kappa = 0.66, same as water</comment>
                </constant>
              </isotropic>
            </value>
            <output/>
          </prescribed>
        </tensor_field>
        <initial_condition name="WholeMesh">
          <constant>
            <real_value rank="0">348</real_value>
          </constant>
        </initial_condition>
        <boundary_conditions name="left">
          <surface_ids>
            <integer_value rank="1" shape="1">7</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <constant>
              <real_value rank="0">423</real_value>
            </constant>
          </type>
        </boundary_conditions>
        <boundary_conditions name="right">
          <surface_ids>
            <integer_value rank="1" shape="1">8</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <constant>
              <real_value rank="0">348</real_value>
            </constant>
          </type>
        </boundary_conditions>
        <boundary_conditions name="rest">
          <surface_ids>
            <integer_value rank="1" shape="2">9 10</integer_value>
          </surface_ids>
          <type name="zero_flux"/>
        </boundary_conditions>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <galerkin_projection>
          <continuous>
            <solver/>
          </continuous>
        </galerkin_projection>
      </prognostic>
    </scalar_field>
    <scalar_field rank="0" name="PassiveTracer">
      <prognostic>
        <mesh name="PressureMesh"/>
        <Do_not_impose_min_max/>
        <tensor_field name="Diffusivity" rank="2">
          <prescribed>
            <value name="WholeMesh">
              <isotropic>
                <constant>
                  <real_value rank="0">0.66e-4</real_value>
                  <comment>concentration diffusivity = kappa/rhof

kappa = 0.66, same as water</comment>
                </constant>
              </isotropic>
            </value>
            <output/>
          </prescribed>
        </tensor_field>
        <initial_condition name="WholeMesh">
          <constant>
            <real_value rank="0">348</real_value>
          </constant>
        </initial_condition>
        <boundary_conditions name="left">
          <surface_ids>
            <integer_value rank="1" shape="1">7</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <constant>
              <real_value rank="0">423</real_value>
            </constant>
          </type>
        </boundary_conditions>
        <boundary_conditions name="right">
          <surface_ids>
            <integer_value rank="1" shape="1">8</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <constant>
              <real_value rank="0">348</real_value>
            </constant>
          </type>
        </boundary_conditions>
        <boundary_conditions name="rest">
          <surface_ids>
            <integer_value rank="1" shape="2">9 10</integer_value>
          </surface_ids>
          <type name="zero_flux"/>
        </boundary_conditions>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <galerkin_projection>
          <continuous>
            <solver/>
          </continuous>
        </galerkin_projection>
      </prognostic>
    </scalar_field>
    <scalar_field rank="0" name="Temperature">
      <prognostic>
        <mesh name="PressureMesh"/>
        <Do_not_impose_min_max/>
        <initial_condition name="WholeMesh">
          <constant>
            <real_value rank="0">348</real_value>
          </constant>
        </initial_condition>
        <boundary_conditions name="left">
          <surface_ids>
            <integer_value rank="1" shape="1">7</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <constant>
              <real_value rank="0">423</real_value>
            </constant>
          </type>
        </boundary_conditions>
        <boundary_conditions name="right">
          <surface_ids>
            <integer_value rank="1" shape="1">8</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly/>
            <constant>
              <real_value rank="0">348</real_value>
            </constant>
          </type>
        </boundary_conditions>
        <boundary_conditions name="rest">
          <surface_ids>
            <integer_value rank="1" shape="2">9 10</integer_value>
          </surface_ids>
          <type name="zero_flux"/>
        </boundary_conditions>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <galerkin_projection>
          <continuous>
            <solver/>
          </continuous>
        </galerkin_projection>
      </prognostic>
    </scalar_field>
  </material_phase>
  <porous_media>
    <scalar_field name="Porosity">
      <prescribed>
        <mesh name="P0DG"/>
        <value name="WholeMesh">
          <constant>
            <real_value rank="0">0.35</real_value>
          </constant>
        </value>
        <stat/>
        <detectors>
          <exclude_from_detectors/>
        </detectors>
        <output/>
      </prescribed>
    </scalar_field>
    <tensor_field name="Permeability">
      <prescribed>
        <mesh name="P0DG"/>
        <value name="WholeMesh">
          <isotropic>
            <constant>
              <real_value rank="0">1.0204e-9</real_value>
            </constant>
          </isotropic>
        </value>
        <output/>
      </prescribed>
    </tensor_field>
    <porous_properties>
      <scalar_field name="porous_density">
        <dry_value>
          <prescribed>
            <mesh name="P0DG"/>
            <value name="WholeMesh">
              <constant>
                <real_value rank="0">0</real_value>
              </constant>
            </value>
            <stat/>
            <detectors>
              <exclude_from_detectors/>
            </detectors>
            <output/>
          </prescribed>
        </dry_value>
      </scalar_field>
      <scalar_field name="porous_heat_capacity">
        <dry_value>
          <prescribed>
            <mesh name="P0DG"/>
            <value name="WholeMesh">
              <constant>
                <real_value rank="0">0</real_value>
              </constant>
            </value>
            <stat/>
            <detectors>
              <exclude_from_detectors/>
            </detectors>
            <output/>
          </prescribed>
        </dry_value>
      </scalar_field>
      <tensor_field name="porous_thermal_conductivity">
        <dry_value>
          <prescribed>
            <mesh name="P0DG"/>
            <value name="WholeMesh">
              <isotropic>
                <constant>
                  <real_value rank="0">0</real_value>
                </constant>
              </isotropic>
            </value>
            <output/>
          </prescribed>
          <Wiener_conductivity/>
        </dry_value>
      </tensor_field>
    </porous_properties>
  </porous_media>
</icferst_options>
