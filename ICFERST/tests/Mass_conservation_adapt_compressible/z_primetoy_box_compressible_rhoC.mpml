<?xml version='1.0' encoding='utf-8'?>
<icferst_options>
  <simulation_name>
    <string_value lines="1">z_primetoy_box_compressible_rhoC</string_value>
  </simulation_name>
  <porous_media_simulator />
  <geometry>
    <dimension>
      <integer_value rank="0">3</integer_value>
    </dimension>
    <mesh name="CoordinateMesh">
      <from_file file_name="box">
        <format name="gmsh" />
        <stat>
          <include_in_stat />
        </stat>
      </from_file>
    </mesh>
    <simulation_quality>
      <string_value>balanced</string_value>
    </simulation_quality>
  </geometry>
  <solver_options>
    <Non_Linear_Solver>
      <integer_value rank="0">25</integer_value>
      <Fixed_Point_Iteration>
        <real_value rank="0">0.05</real_value>
        <Infinite_norm_tol>
          <real_value rank="0">0.03</real_value>
          <adaptive_non_linear_iterations>
            <integer_value rank="0">1</integer_value>
          </adaptive_non_linear_iterations>
        </Infinite_norm_tol>
        <Backtracking_factor>
          <real_value rank="0">-10</real_value>
        </Backtracking_factor>
        <adaptive_timestep_nonlinear>
          <integer_value rank="0">1</integer_value>
          <PID_controller>
            <Aim_num_FPI>
              <integer_value rank="0">5</integer_value>
            </Aim_num_FPI>
          </PID_controller>
          <ensure_solvers_convergence />
          <increase_factor>
            <real_value rank="0">2</real_value>
          </increase_factor>
          <max_timestep>
            <constant>
              <real_value rank="0">86400</real_value>
            </constant>
          </max_timestep>
          <min_timestep>
            <constant>
              <real_value rank="0">1</real_value>
            </constant>
          </min_timestep>
        </adaptive_timestep_nonlinear>
      </Fixed_Point_Iteration>
    </Non_Linear_Solver>
  </solver_options>
  <io>
    <dump_format>
      <string_value>vtk</string_value>
    </dump_format>
    <dump_units_SI />
    <dump_period>
      <constant>
        <real_value rank="0">500.0</real_value>
        <comment>0.1 month	262800
0.2month	525600
0.25 month	657000
0.333 month	876000
0.5month	1314000
1hr	3600
1day	86400
1month	2628000
3month	7884000
1year	31536000</comment>
      </constant>
    </dump_period>
    <Show_Convergence />
    <dump_boundaryflux>
      <surface_ids>
        <integer_value rank="1" shape="6">1 2 3 4 5 6</integer_value>
      </surface_ids>
    </dump_boundaryflux>
    </io>
  <timestepping>
    <current_time>
      <real_value rank="0">0.0</real_value>
    </current_time>
    <timestep>
      <real_value rank="0">100.0</real_value>
      <comment>259200 = 3 days</comment>
    </timestep>
    <finish_time>
      <real_value rank="0">3000.0</real_value>
      <comment>3.1536E+08= 10 years
259200 = 72hrs
518400 = 144 hrs
1036800 = 288 hrs</comment>
    </finish_time>
  </timestepping>
  <physical_parameters>
    <gravity>
      <magnitude>
        <real_value rank="0">0.0</real_value>
      </magnitude>
      <vector_field name="GravityDirection" rank="1">
        <prescribed>
          <mesh name="CoordinateMesh" />
          <value name="WholeMesh">
            <constant>
              <real_value rank="1" dim1="dim" shape="3">0 0 -1</real_value>
            </constant>
          </value>
          <stat>
            <include_in_stat />
          </stat>
          <detectors>
            <exclude_from_detectors />
          </detectors>
        </prescribed>
      </vector_field>
    </gravity>
  </physical_parameters>
  <material_phase name="water">
    <phase_properties>
      <Density>
        <compressible>
          <Linear_eos>
            <reference_density>
              <real_value rank="0">1000</real_value>
            </reference_density>
            <C0>
              <real_value rank="0">4.e-5</real_value>
            </C0>
            <alpha>
              <real_value rank="0">0.8</real_value>
            </alpha>
          </Linear_eos>
          </compressible>
        </Density>
      <Viscosity>
        <tensor_field name="Viscosity" rank="2">
          <prescribed>
            <mesh name="PressureMesh" />
            <value name="WholeMesh">
              <isotropic>
                <constant>
                  <real_value rank="0">0.001</real_value>
                </constant>
              </isotropic>
            </value>
          </prescribed>
        </tensor_field>
        <viscosity_scheme>
          <tensor_form />
          <nonlinear_scheme />
        </viscosity_scheme>
      </Viscosity>
    </phase_properties>
    <scalar_field rank="0" name="Pressure">
      <prognostic>
        <mesh name="PressureMesh" />
        <initial_condition name="WholeMesh">
          <constant><real_value rank="0">1.0e5</real_value></constant></initial_condition>
        <boundary_conditions name="sides">
          <surface_ids>
            <integer_value rank="1" shape="4">3 4 5 6</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly />
            <constant><real_value rank="0">1.0e5</real_value></constant></type>
        </boundary_conditions>
        <detectors>
          <include_in_detectors />
        </detectors>
        <adaptivity_options>
          <relative_measure>
            <scalar_field rank="0" name="InterpolationErrorBound">
              <prescribed>
                <value name="WholeMesh">
                  <constant>
                    <real_value rank="0">1.0e12</real_value>
                  </constant>
                </value>
                <stat />
                <detectors>
                  <exclude_from_detectors />
                </detectors>
              </prescribed>
            </scalar_field>
          </relative_measure>
        </adaptivity_options>
        <galerkin_projection>
          <continuous>
            <solver />
          </continuous>
        </galerkin_projection>
        <output />
      </prognostic>
    </scalar_field>
    <vector_field rank="1" name="Velocity">
      <prognostic>
        <mesh name="VelocityMesh" />
        <initial_condition name="WholeMesh">
          <constant>
            <real_value rank="1" dim1="dim" shape="3">0 0 0</real_value>
          </constant>
        </initial_condition>
        <boundary_conditions name="base_top">
          <surface_ids>
            <integer_value rank="1" shape="9">1 2</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly />
            <align_bc_with_cartesian>
              <x_component>
                <constant>
                  <real_value rank="0">0</real_value>
                </constant>
              </x_component>
              <y_component>
                <constant>
                  <real_value rank="0">0</real_value>
                </constant>
              </y_component>
              <z_component>
                <constant>
                  <real_value rank="0">0</real_value>
                </constant>
              </z_component>
            </align_bc_with_cartesian>
          </type>
        </boundary_conditions>
        <detectors>
          <exclude_from_detectors />
        </detectors>
        <galerkin_projection>
          <discontinuous />
        </galerkin_projection>
        <output />
      </prognostic>
    </vector_field>
    <scalar_field rank="0" name="PhaseVolumeFraction">
      <prognostic>
        <mesh name="PressureMesh" />
        <initial_condition name="WholeMesh">
          <constant>
            <real_value rank="0">1</real_value>
          </constant>
        </initial_condition>
        <boundary_conditions name="all">
          <surface_ids>
            <integer_value rank="1" shape="13">1 2 3 4 5 6</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly />
            <constant>
              <real_value rank="0">1</real_value>
            </constant>
          </type>
        </boundary_conditions>
        <detectors>
          <exclude_from_detectors />
        </detectors>
        <galerkin_projection>
          <continuous>
            <solver />
          </continuous>
        </galerkin_projection>
      </prognostic>
    </scalar_field>
    <scalar_field rank="0" name="Concentration">
      <prognostic>
        <mesh name="PressureMesh" />
        <Do_not_impose_min_max />
        <tensor_field name="Diffusivity" rank="2">
          <prescribed>
            <value name="WholeMesh">
              <isotropic>
                <constant>
                  <real_value rank="0">0.0</real_value>
                </constant>
              </isotropic>
            </value>
            <output />
          </prescribed>
        </tensor_field>
        <initial_condition name="WholeMesh">
          <python><string_value lines="20" type="code" language="python">def val(X,t):
  return 4.0e-5 + 0.19*max(0.0, min(1.0, X[0]/100.0))</string_value></python></initial_condition>
        <boundary_conditions name="all">
          <surface_ids>
            <integer_value rank="1" shape="13">1 2 3 4 5 6</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <apply_weakly />
            <python><string_value lines="20" type="code" language="python">def val(X,t):
  return 4.0e-5 + 0.19*max(0.0, min(1.0, X[0]/100.0))</string_value></python></type>
        </boundary_conditions>
        <detectors>
          <include_in_detectors />
        </detectors>
        <adaptivity_options>
          <relative_measure>
            <scalar_field rank="0" name="InterpolationErrorBound">
              <prescribed>
                <value name="WholeMesh">
                  <constant>
                    <real_value rank="0">0.02</real_value>
                  </constant>
                </value>
                <stat />
                <detectors>
                  <exclude_from_detectors />
                </detectors>
              </prescribed>
            </scalar_field>
          </relative_measure>
        </adaptivity_options>
        <galerkin_projection>
          <continuous>
            <bounded name="Diffuse">
              <boundedness_iterations>
                <integer_value rank="0">100</integer_value>
              </boundedness_iterations>
            </bounded>
            <solver />
          </continuous>
        </galerkin_projection>
      </prognostic>
    </scalar_field>
  </material_phase>
  <mesh_adaptivity>
    <hr_adaptivity>
      <period_in_timesteps>
        <constant>
          <integer_value rank="0">5</integer_value>
        </constant>
      </period_in_timesteps>
      <maximum_number_of_nodes>
        <integer_value rank="0">100000</integer_value>
      </maximum_number_of_nodes>
      <enable_gradation>
        <gradation_parameter>
          <real_value rank="0">1.5</real_value>
        </gradation_parameter>
      </enable_gradation>
      <tensor_field name="MinimumEdgeLengths">
        <anisotropic_symmetric>
          <python>
            <string_value type="code" language="python" lines="20">def val(X,t):
  e = 3.0
  return [[e,0,0],[0,e,0],[0,0,e]]</string_value>
          </python>
        </anisotropic_symmetric>
      </tensor_field>
      <tensor_field name="MaximumEdgeLengths">
        <anisotropic_symmetric>
          <python>
            <string_value type="code" language="python" lines="20">def val(X,t):
  e = 25.0
  return [[e,0,0],[0,e,0],[0,0,e]]</string_value>
          </python>
        </anisotropic_symmetric>
      </tensor_field>
      <adapt_at_first_timestep>
        <number_of_adapts>
          <integer_value rank="0">3</integer_value>
        </number_of_adapts>
        <output_adapted_mesh />
      </adapt_at_first_timestep>
      </hr_adaptivity>
  </mesh_adaptivity>
  <porous_media>
    <scalar_field name="Porosity">
      <prescribed>
        <mesh name="P0DG" />
        <value name="WholeMesh"><constant><real_value rank="0">0.3</real_value></constant></value><stat />
        <detectors>
          <exclude_from_detectors />
        </detectors>
        <output />
      </prescribed>
    </scalar_field>
    <vector_field name="Permeability">
      <prescribed>
        <mesh name="P0DG" />
        <value name="WholeMesh"><constant><real_value rank="1" dim1="dim" shape="3">1.0e-12 1.0e-12 1.0e-12</real_value></constant></value><stat>
          <include_in_stat />
        </stat>
        <detectors>
          <exclude_from_detectors />
        </detectors>
        <output />
      </prescribed>
    </vector_field>
    <Dispersion>
      <scalar_field name="Longitudinal_Dispersivity">
        <prescribed>
          <mesh name="P0DG" />
          <value name="WholeMesh">
            <constant>
              <real_value rank="0">0.0</real_value>
            </constant>
          </value>
          <stat />
          <detectors>
            <exclude_from_detectors />
          </detectors>
          <output />
        </prescribed>
      </scalar_field>
      <scalar_field name="Transverse_Dispersivity">
        <prescribed>
          <mesh name="P0DG" />
          <value name="WholeMesh">
            <constant>
              <real_value rank="0">0.0</real_value>
            </constant>
          </value>
          <stat />
          <detectors>
            <exclude_from_detectors />
          </detectors>
          <output />
        </prescribed>
      </scalar_field>
    </Dispersion>
    <porous_properties>
      <scalar_field name="porous_density">
        <dry_value>
          <prescribed>
            <mesh name="P0DG" />
            <value name="WholeMesh"><constant>
                <real_value rank="0">2380</real_value>
              </constant>
            </value><stat />
            <detectors>
              <exclude_from_detectors />
            </detectors>
            <output />
          </prescribed>
        </dry_value>
      </scalar_field>
      <scalar_field name="porous_heat_capacity">
        <dry_value>
          <prescribed>
            <mesh name="P0DG" />
            <value name="WholeMesh"><constant>
                <real_value rank="0">900</real_value>
              </constant>
            </value><stat />
            <detectors>
              <exclude_from_detectors />
            </detectors>
            <output />
          </prescribed>
        </dry_value>
      </scalar_field>
      <tensor_field name="porous_thermal_conductivity">
        <dry_value>
          <prescribed>
            <mesh name="P0DG" />
            <value name="WholeMesh"><isotropic>
                <constant>
                  <real_value rank="0">3.6952</real_value>
                </constant>
              </isotropic>
            </value><output />
          </prescribed>
          <Wiener_conductivity />
        </dry_value>
      </tensor_field>
      <scalar_field name="porosity_total">
        <prescribed>
          <mesh name="P0DG" />
          <value name="WholeMesh"><constant><real_value rank="0">0.3</real_value></constant></value><stat />
          <detectors>
            <exclude_from_detectors />
          </detectors>
          <output />
        </prescribed>
      </scalar_field>
    </porous_properties>
    </porous_media>
  <numerical_methods>
    </numerical_methods>
</icferst_options>