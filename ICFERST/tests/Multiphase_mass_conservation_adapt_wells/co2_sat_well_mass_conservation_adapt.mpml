                  <constant>
                    <real_value rank="0">0.01</real_value>
                  </constant>
                </value>
                <stat/>
                <detectors>
                  <exclude_from_detectors/>
                </detectors>
              </prescribed>
            </scalar_field>
          </relative_measure>
        </adaptivity_options>
        <galerkin_projection>
          <continuous>
            <bounded name="Diffuse">
              <boundedness_iterations>
                <integer_value rank="0">100</integer_value>
              </boundedness_iterations>
            </bounded>
            <solver/>
          </continuous>
        </galerkin_projection>
      </prognostic>
    </scalar_field>
    <multiphase_properties>
      <type_Formula>
        <Relperm_Corey>
          <scalar_field name="relperm_max">
            <prescribed>
              <mesh name="P0DG"/>
