  <porous_media>
    <scalar_field name="Porosity">
      <prescribed>
        <mesh name="P0DG"/>
        <value name="Reszone1">
          <region_ids>
            <integer_value rank="1" shape="2">1 11</integer_value>
          </region_ids>
