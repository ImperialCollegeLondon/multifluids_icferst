    </scalar_field>
    <vector_field name="Permeability">
      <prescribed>
        <mesh name="P0DG"/>
        <value name="Reszone1">
          <region_ids>
            <integer_value rank="1" shape="2">1 11</integer_value>
          </region_ids>
          <constant>
            <real_value rank="1" dim1="dim" shape="3">1e-13 1e-13 1e-13</real_value>
          </constant>
        </value>
        <value name="Barrier">
          <region_ids>
            <integer_value rank="1" shape="2">2 21</integer_value>
          </region_ids>
          <constant>
            <real_value rank="1" dim1="dim" shape="3">1e-18 1e-18 1e-18</real_value>
          </constant>
        </value>
        <value name="Reszone2">
          <region_ids>
            <integer_value rank="1" shape="2">3 31</integer_value>
          </region_ids>
          <constant>
            <real_value rank="1" dim1="dim" shape="3">1.5e-12 1.5e-12 1.5e-12</real_value>
          </constant>
        </value>
        <stat>
          <include_in_stat/>
        </stat>
        <detectors>
          <exclude_from_detectors/>
        </detectors>
        <output/>
      </prescribed>
    </vector_field>
    <wells_and_pipes>
      <scalar_field name="Gamma">
        <prescribed>
          <mesh name="PressureMesh"/>
          <value name="wellsleeve">
            <region_ids>
              <integer_value rank="1" shape="3">11 21 31</integer_value>
            </region_ids>
            <python>
              <string_value type="code" language="python" lines="20">def val(X,t):
 g = 0
 if X[2] &lt; 60:
  g = 1
 return g</string_value>
            </python>
          </value>
          <stat/>
          <detectors>
            <exclude_from_detectors/>
          </detectors>
          <output/>
        </prescribed>
      </scalar_field>
      <scalar_field name="Sigma">
        <prescribed>
          <mesh name="PressureMesh_Discontinuous"/>
          <value name="WholeMesh">
            <constant>
              <real_value rank="0">1</real_value>
            </constant>
          </value>
          <stat/>
          <detectors>
            <exclude_from_detectors/>
          </detectors>
          <output/>
        </prescribed>
      </scalar_field>
      <scalar_field name="DiameterPipe">
        <prescribed>
          <mesh name="PressureMesh"/>
          <value name="WholeMesh">
            <constant>
              <real_value rank="0">0.2</real_value>
            </constant>
          </value>
          <stat/>
          <detectors>
            <exclude_from_detectors/>
          </detectors>
          <output/>
        </prescribed>
      </scalar_field>
      <well_volume_ids>
        <integer_value rank="1" shape="3">11 21 31</integer_value>
        <Lock_sleeve_nodes/>
        <Show_well_volumes_ids/>
      </well_volume_ids>
      <well_from_file name="Injector" file_path="co2_toy_well_welltrace"/>
    </wells_and_pipes>
  </porous_media>
  <numerical_methods/>
</icferst_options>
