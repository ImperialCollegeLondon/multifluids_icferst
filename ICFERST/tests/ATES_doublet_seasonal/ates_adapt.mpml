          <type name="dirichlet">
            <apply_weakly />
            <align_bc_with_cartesian>
              <x_component>
                <constant>
                  <real_value rank="0">0</real_value>
                </constant>
              </x_component>
              <y_component>
                <constant>
                  <real_value rank="0">0</real_value>
                </constant>
              </y_component>
              <z_component>
                <python>
                  <string_value type="code" language="python" lines="20">def val(X,t):
 yr = (int(t/(3.0*4*24*3600)))*24*3600*4*3.0
 if t-yr&gt;=0 and t-yr &lt; 3.0*24*3600:
  vel = -0.165
 elif t-yr&gt;= 3.0*24*3600*2 and t-yr &lt; 3.0*24*3600*3:
  vel = 0.165
 else:
  vel = 0
 return  vel</string_value>
                </python>
              </z_component>
            </align_bc_with_cartesian>
          </type>
        </boundary_conditions>
