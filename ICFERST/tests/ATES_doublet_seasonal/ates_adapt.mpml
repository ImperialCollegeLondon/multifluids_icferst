<?xml version='1.0' encoding='utf-8'?>
<icferst_options>
  <simulation_name>
    <string_value lines="1">ates_adapt</string_value>
  </simulation_name>
  <porous_media_simulator />
  <geometry>
    <dimension>
      <integer_value rank="0">3</integer_value>
    </dimension>
    <mesh name="CoordinateMesh">
      <from_file file_name="ates_doublet">
        <format name="gmsh" />
        <stat>
          <include_in_stat />
        </stat>
      </from_file>
    </mesh>
    <simulation_quality>
      <string_value>balanced</string_value>
    </simulation_quality>
  </geometry>
  <solver_options>
    <Linear_solver>
      <iterative_method name="gmres">
        <restart>
          <integer_value rank="0">30</integer_value>
        </restart>
      </iterative_method>
      <preconditioner name="hypre">
        <hypre_type name="boomeramg" />
      </preconditioner>
      <relative_error>
        <real_value rank="0">1.0e-13</real_value>
      </relative_error>
      <max_iterations>
        <integer_value rank="0">1000</integer_value>
      </max_iterations>
      <ignore_all_solver_failures />
      <diagnostics>
        <monitors />
      </diagnostics>
      <Custom_solver_configuration />
    </Linear_solver>
    <Non_Linear_Solver>
      <integer_value rank="0">20</integer_value>
      <Fixed_Point_Iteration>
        <real_value rank="0">0.05</real_value>
        <Infinite_norm_tol>
          <real_value rank="0">0.03</real_value>
          <adaptive_non_linear_iterations>
            <integer_value rank="0">1</integer_value>
          </adaptive_non_linear_iterations>
        </Infinite_norm_tol>
        <Backtracking_factor>
          <real_value rank="0">-10</real_value>
        </Backtracking_factor>
        <adaptive_timestep_nonlinear>
          <integer_value rank="0">1</integer_value>
          <PID_controller>
            <Aim_num_FPI>
              <integer_value rank="0">5</integer_value>
            </Aim_num_FPI>
          </PID_controller>
          <ensure_solvers_convergence />
          <increase_factor>
            <real_value rank="0">1.1</real_value>
          </increase_factor>
          <max_timestep>
            <constant>
              <real_value rank="0">43200</real_value>
            </constant>
          </max_timestep>
          <min_timestep>
            <constant>
              <real_value rank="0">1800</real_value>
            </constant>
          </min_timestep>
        </adaptive_timestep_nonlinear>
      </Fixed_Point_Iteration>
    </Non_Linear_Solver>
  </solver_options>
  <io>
    <dump_format>
      <string_value>vtk</string_value>
    </dump_format>
    <dump_units_SI />
    <dump_period>
      <constant>
        <real_value rank="0">432000</real_value>
      </constant>
    </dump_period>
    <Show_Convergence_Detailed />
    <dump_boundaryflux>
      <surface_ids>
