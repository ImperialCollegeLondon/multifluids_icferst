<?xml version='1.0' encoding='UTF-8'?>
<icferst_options>
  <simulation_name>
    <string_value lines="1">doublet_beta1_fixed</string_value>
  </simulation_name>
  <porous_media_simulator/>
  <geometry>
    <dimension>
      <integer_value rank="0">3</integer_value>
    </dimension>
    <mesh name="CoordinateMesh">
      <from_file file_name="wells_doublet">
        <format name="gmsh"/>
        <stat>
          <include_in_stat/>
        </stat>
      </from_file>
    </mesh>
    <simulation_quality>
      <string_value>balanced</string_value>
    </simulation_quality>
    <Advance_options>
      <Conservative_formulation_settings name="Tracer">
        <conservative_advection>
          <real_value rank="0">1.0</real_value>
        </conservative_advection>
      </Conservative_formulation_settings>
    </Advance_options>
  </geometry>
  <solver_options>
    <Linear_solver>
      <iterative_method name="gmres">
        <restart>
          <integer_value rank="0">30</integer_value>
        </restart>
      </iterative_method>
      <preconditioner name="hypre">
        <hypre_type name="boomeramg"/>
      </preconditioner>
      <relative_error>
        <real_value rank="0">1e-13</real_value>
      </relative_error>
      <max_iterations>
        <integer_value rank="0">10000</integer_value>
      </max_iterations>
      <ignore_all_solver_failures/>
      <diagnostics>
        <monitors/>
      </diagnostics>
      <Custom_solver_configuration/>
    </Linear_solver>
    <Non_Linear_Solver>
      <integer_value rank="0">20</integer_value>
      <Fixed_Point_Iteration>
        <real_value rank="0">5e-2</real_value>
        <Infinite_norm_tol>
          <real_value rank="0">0.01</real_value>
          <adaptive_non_linear_iterations>
            <integer_value rank="0">1</integer_value>
          </adaptive_non_linear_iterations>
        </Infinite_norm_tol>
        <Backtracking_factor>
          <real_value rank="0">-10</real_value>
        </Backtracking_factor>
        <Vanishing_relaxation>
          <real_value rank="0">0</real_value>
          <Vanishing_for_transport>
            <real_value rank="0">-1e2</real_value>
          </Vanishing_for_transport>
        </Vanishing_relaxation>
        <adaptive_timestep_nonlinear>
          <integer_value rank="0">1</integer_value>
          <PID_controller>
            <Aim_num_FPI>
              <integer_value rank="0">15</integer_value>
            </Aim_num_FPI>
          </PID_controller>
          <ensure_solvers_convergence/>
          <increase_factor>
            <real_value rank="0">1.5</real_value>
          </increase_factor>
          <max_timestep>
            <constant>
              <real_value rank="0">86400</real_value>
            </constant>
          </max_timestep>
          <min_timestep>
            <constant>
              <real_value rank="0">3600</real_value>
            </constant>
          </min_timestep>
        </adaptive_timestep_nonlinear>
      </Fixed_Point_Iteration>
    </Non_Linear_Solver>
  </solver_options>
  <io>
    <dump_format>
      <string_value>vtk</string_value>
    </dump_format>
    <dump_units_SI/>
    <dump_period_in_timesteps>
      <constant>
        <integer_value rank="0">1</integer_value>
      </constant>
    </dump_period_in_timesteps>
    <Show_Convergence_Detailed/>
    <dump_boundaryflux>
      <surface_ids>
        <integer_value rank="1" shape="6">101 102 3 4 5 6</integer_value>
      </surface_ids>
    </dump_boundaryflux>
    </io>
  <timestepping>
    <current_time>
      <real_value rank="0">0.0</real_value>
    </current_time>
    <timestep>
      <real_value rank="0">86400</real_value>
    </timestep>
    <finish_time>
      <real_value rank="0">345600</real_value>
    </finish_time>
  </timestepping>
  <physical_parameters>
    <gravity>
      <magnitude>
        <real_value rank="0">9.81</real_value>
      </magnitude>
      <vector_field name="GravityDirection" rank="1">
        <prescribed>
          <mesh name="CoordinateMesh"/>
          <value name="WholeMesh">
            <constant>
